# Token del bot, da @BotFather.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deve combaciare con cfg()['ingest_token'] della webapp.
INGEST_TOKEN=CHANGE_ME

# Endpoint locali della webapp (il bot gira sullo stesso host).
BOT_API_URL=http://127.0.0.1/snippet/api/bot.php
INGEST_URL=http://127.0.0.1/snippet/api/ingest.php

# Base pubblica del portale, per i link "apri nel web" nelle risposte.
PUBLIC_BASE_URL=https://tuo.host/snippet

# ID Telegram ammessi (csv). Vuoto = si affida solo al gate lato server
# (tg_allowed / ingest_bootstrap_from in config.php).
ALLOWED_IDS=

# PIN di sblocco del bot (facoltativo). Se impostato, finché non lo invii
# in chat il bot non mostra nulla e non esegue comandi; ogni messaggio è un
# tentativo di PIN e viene cancellato subito. Vale SNIPPET_PIN_TIMEOUT secondi
# (finestra fissa), poi va reinserito; anche ogni riavvio del servizio riblocca.
SNIPPET_PIN=
SNIPPET_PIN_TIMEOUT=1800
