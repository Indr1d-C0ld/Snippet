[Unit]
Description=snippet - bot Telegram (interfaccia completa)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snippet-bot
Group=snippet-bot
EnvironmentFile=/opt/snippet-bot/.env
WorkingDirectory=/opt/snippet-bot
ExecStart=/opt/snippet-bot/venv/bin/python /opt/snippet-bot/snippet_bot.py
Restart=always
RestartSec=10
# Parla solo con api.telegram.org e con la webapp su loopback.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
