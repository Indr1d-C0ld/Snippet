# snippet-ml - servizio locale di embedding e trascrizione (ml/snippet_ml.py).
# Ascolta solo su 127.0.0.1; l'unita' systemd gli vieta anche la rete esterna.

ML_HOST=127.0.0.1
ML_PORT=8765

# Token condiviso con la webapp (config.php: 'ml_token') e col bot (ML_TOKEN).
# Generane uno con:  php -r 'echo bin2hex(random_bytes(24)), "\n";'
ML_TOKEN=CHANGE_ME

# Embedding (ricerca per significato, voci simili, correlazioni)
ML_EMBED_DIR=/opt/snippet-ml/models/e5-small
ML_EMBED_NAME=multilingual-e5-small

# Trascrizione (whisper.cpp). Modelli: https://huggingface.co/ggerganov/whisper.cpp
#   ggml-small.bin                488 MB  default: su un i7-4770TE carico, 44 s di
#                                         audio in 37 s (piu' veloce del parlato)
#   ggml-large-v3-turbo-q5_0.bin  574 MB  piu' preciso su nomi e punteggiatura,
#                                         ma ~3-5 volte piu' lento (44 s in 124 s)
#   ggml-base.bin                 148 MB  velocissimo, impreciso in italiano
ML_WHISPER_BIN=/opt/snippet-ml/bin/whisper-cli
ML_WHISPER_MODEL=/opt/snippet-ml/models/ggml-small.bin
ML_WHISPER_LANG=it
# thread usati da una trascrizione (gira comunque con priorita' minima)
ML_WHISPER_THREADS=4
ML_MAX_AUDIO_SECONDS=900
